{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/core/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/core/server.js",
    "lint": "tsc --noEmit",
    "readiness:phase1": "tsx src/jobs/check-phase1-readiness.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "jobs:run": "tsx src/jobs/run-all.ts",
    "jobs:cleanup": "tsx src/jobs/cleanup-maintenance.ts",
    "jobs:reminders": "tsx src/jobs/send-ops-reminders.ts",
    "jobs:email-retry": "tsx src/jobs/retry-email-deliveries.ts",
    "jobs:backup": "tsx src/jobs/backup-database.ts",
    "db:start": "powershell -ExecutionPolicy Bypass -File scripts/start-local-postgres.ps1",
    "db:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-local-postgres.ps1",
    "db:status": "powershell -ExecutionPolicy Bypass -File scripts/status-local-postgres.ps1",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@sentry/node": "^10.50.0",
    "bcryptjs": "^3.0.2",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "latest",
    "stripe": "^22.0.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "latest",
    "@types/supertest": "^7.2.0",
    "prisma": "^6.16.2",
    "supertest": "^7.2.2",
    "tsx": "latest",
    "typescript": "latest"
  }
}
